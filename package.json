{
  "name": "grantmatch-ai",
  "version": "1.0.0",
  "description": "Open-source AI-powered grant discovery and matching platform for NGOs",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-prisma.js && next dev",
    "build": "node scripts/prepare-prisma.js && prisma generate && next build --webpack",
    "start": "node scripts/prepare-prisma.js && prisma db push && npx ts-node -O '{\"module\":\"commonjs\"}' prisma/seed.ts && next start",
    "lint": "next lint",
    "db:generate": "node scripts/prepare-prisma.js && prisma generate",
    "db:push": "node scripts/prepare-prisma.js && prisma db push",
    "db:seed": "node scripts/prepare-prisma.js && npx ts-node -O '{\"module\":\"commonjs\"}' prisma/seed.ts",
    "test": "node scripts/prepare-prisma.js && jest --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.21.1",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^16.3.5",
    "openai": "^4.68.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jest": "^29.7.0",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
