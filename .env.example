# GrantMatch AI Configuration Environment Variables
# Copy to .env for local overrides

# Application URL
APP_URL="http://localhost:3000"

# Database Configuration
# In production (e.g. Railway Postgres), supply postgresql://...
# In local development without Postgres, SQLite is supported out of the box.
DATABASE_URL="file:./dev.db"

# LLM Providers (Optional - at least one for advanced AI extraction/explanations;
# if none are provided, GrantMatch AI operates in Deterministic Heuristic Demo Mode)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Web Search Provider for Live Grant Discovery
# Options: "mock" (default, free demo mode), "tavily", "serper", "brave", "google"
SEARCH_PROVIDER="mock"
SEARCH_API_KEY=""

# Rate Limiting & Usage Controls
# Maximum anonymous live web searches per IP per 24-hour period
RATE_LIMIT_PER_DAY=3

# Maximum search queries to generate per discovery run
MAX_QUERIES_PER_SEARCH=5

# Maximum URLs to scrape during a single live discovery run
MAX_URLS_PER_DISCOVERY=20
